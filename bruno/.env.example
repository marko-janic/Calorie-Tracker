# Dev device key for the Bruno collection (git-ignored copy: bruno/.env).
# Create one with:
#   node -e "const {generateKeyPairSync}=require('crypto');const {privateKey}=generateKeyPairSync('ec',{namedCurve:'P-256'});console.log('KCAL_DEV_KEY_PKCS8='+privateKey.export({type:'pkcs8',format:'der'}).toString('base64'))" > .env
KCAL_DEV_KEY_PKCS8=
