meta {
  name: 01 health
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/health
  body: none
  auth: none
}

script:post-response {
  bru.setEnvVar("serverId", res.body.serverId);
}

tests {
  test("server is healthy", function () {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("ok");
    expect(res.body.apiVersion).to.equal(1);
    expect(res.body.serverId).to.be.a("string");
  });
}
