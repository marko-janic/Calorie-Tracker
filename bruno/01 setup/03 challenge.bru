meta {
  name: 03 challenge
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/challenge
  body: json
  auth: none
}

body:json {
  {
    "deviceId": "{{deviceId}}"
  }
}

script:post-response {
  bru.setEnvVar("nonce", res.body.nonce);
}

tests {
  test("returns a nonce", function () {
    expect(res.status).to.equal(200);
    expect(res.body.nonce).to.be.a("string");
  });
}
