meta {
  name: 01 push new entry
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/sync/push
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:pre-request {
  const kcal = require("./lib/kcal.js");
  const id = require("crypto").randomUUID();
  bru.setEnvVar("entryId", id);
  req.setBody({ entries: [kcal.entryChange(id)], profile: null });
}

script:post-response {
  bru.setEnvVar("entryVersion", res.body.entries[0].version);
}

tests {
  test("entry is applied", function () {
    expect(res.status).to.equal(200);
    expect(res.body.entries[0].status).to.equal("applied");
    expect(res.body.entries[0].version).to.be.a("number");
  });
}
