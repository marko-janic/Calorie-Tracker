# Cloudflare API token (custom token, used only by kcal):
#   Permissions:     Zone > DNS > Edit, Zone > Zone > Read
#   Zone resources:  Include > Specific zone > example.com
#   Optional:        Client IP filtering, if the home public IP is static
CLOUDFLARE_API_TOKEN=

# HTTPS port on this VM: 443 if free (sudo ss -tlnp | grep ':443'), otherwise 8443
KCAL_HTTPS_PORT=443

# GitHub user or organisation that owns the GHCR images
KCAL_IMAGE_OWNER=

KCAL_API_HOST=kcal.example.com
KCAL_UI_HOST=ui.kcal.example.com
# Include the port if KCAL_HTTPS_PORT is not 443, e.g. https://ui.kcal.example.com:8443
KCAL_UI_ORIGIN=https://ui.kcal.example.com

# "latest" (optionally with Watchtower) or a pinned version, e.g. v0.3.0
KCAL_VERSION=latest
