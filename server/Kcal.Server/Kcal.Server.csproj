<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../VERSION').Trim())</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- GHSA-v5pm-xwqc-g5wc: Microsoft.OpenApi 2.1.0 has a known DoS vulnerability in OpenApiReader.
         Cannot upgrade to 3.x because Microsoft.AspNetCore.OpenApi 10.0.0 source generator is incompatible
         with OpenApi 3.x (IOpenApiMediaType.Example is read-only in 3.x).
         Risk is mitigated: The vulnerability affects parsing untrusted OpenAPI documents. This app only
         generates OpenAPI documents from code; it never parses external OpenAPI input.
         TODO: Upgrade to Microsoft.OpenApi 3.x once Microsoft.AspNetCore.OpenApi adds support. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v5pm-xwqc-g5wc" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Transitive dependency version overrides for security vulnerabilities.
       These are not direct dependencies but are pinned to override vulnerable transitive versions.
       Review and remove once the parent packages ship with patched versions. -->
  <ItemGroup>
    <!-- Microsoft.OpenApi 2.1.0: Cannot upgrade to 3.x yet (see NuGetAuditSuppress above) -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.1.0" />
    <!-- SQLitePCLRaw.lib.e_sqlite3: Pinned to ensure EF Core Sqlite bundle uses latest native library -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <!-- GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7: System.Security.Cryptography.Pkcs 10.0.0 - Updated to 10.0.14 to fix vulnerabilities -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

</Project>
